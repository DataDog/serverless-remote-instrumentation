{
  "name": "serverless-remote-instrumentation",
  "description": "Remote Instrumenter Lambda function for Datadog Serverless Remote Instrumentation",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@datadog/datadog-ci-base": "5.11.0",
    "@datadog/datadog-ci-plugin-lambda": "5.11.0",
    "axios": "1.13.5"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "~3.990.0",
    "@aws-sdk/client-lambda": "~3.990.0",
    "@aws-sdk/client-resource-groups-tagging-api": "~3.990.0",
    "@aws-sdk/client-s3": "~3.990.0",
    "@aws-sdk/client-secrets-manager": "~3.990.0",
    "@aws-sdk/s3-request-presigner": "~3.990.0",
    "@datadog/datadog-api-client": "^1.53.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/cfn-response": "^1.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "aws-cdk": "^2.1112.0",
    "aws-cdk-lib": "^2.243.0",
    "cfn-response": "^1.0.1",
    "constructs": "^10.5.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-yml": "^3.3.1",
    "globals": "^17.4.0",
    "jszip": "^3.10.1",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0",
    "yaml-cfn": "^0.3.2"
  },
  "resolutions": {
    "@aws-cdk/cloud-assembly-schema": ">=52.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/src/handler.mjs --packages=external",
    "typecheck": "tsc --noEmit",
    "format": "eslint --fix .",
    "lint": "eslint -c eslint.config.mjs . ",
    "lint-yaml": "eslint -c eslint.config.yaml.mjs . ",
    "format-yaml": "eslint --fix -c eslint.config.yaml.mjs . ",
    "create-release": "bash scripts/create_release.sh $1",
    "test": "vitest run --config vitest.config.ts",
    "integ": "vitest run --config integration-tests/vitest.config.ts",
    "metrics-validations": "vitest run --config metrics-validations/vitest.config.ts",
    "integ-test-setup": "bash -c 'if [ -n \"$CI_PROJECT_DIR\" ]; then node ${SCRIPTS_PATH}/test_setup.js; else node scripts/test_setup.js; fi'",
    "integ-test-teardown": "bash -c 'if [ -n \"$CI_PROJECT_DIR\" ]; then node ${SCRIPTS_PATH}/test_teardown.js; else node scripts/test_teardown.js; fi'"
  }
}
