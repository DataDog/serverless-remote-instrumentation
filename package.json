{
  "name": "serverless-remote-instrumentation",
  "description": "Remote instrumentater lambda function for Datadog Serverless Remote Instrumentation",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@datadog/datadog-ci-base": "^4.4.0",
    "@datadog/datadog-ci-plugin-lambda": "^4.4.0",
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.893.0",
    "@aws-sdk/client-lambda": "3.899.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.899.0",
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/client-secrets-manager": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.893.0",
    "@datadog/datadog-api-client": "^1.43.0",
    "@types/cfn-response": "^1.0.8",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "aws-cdk": "^2.1029.2",
    "aws-cdk-lib": "^2.216.0",
    "cfn-response": "^1.0.1",
    "constructs": "^10.4.2",
    "esbuild": "^0.27.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-yml": "^1.16.0",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "jszip": "^3.10.1",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.1.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "yaml-cfn": "^0.3.2"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/src/handler.mjs --packages=external",
    "typecheck": "tsc --noEmit",
    "format": "eslint --fix .",
    "lint": "eslint -c eslint.config.mjs . ",
    "lint-yaml": "eslint -c eslint.config.yaml.mjs . ",
    "format-yaml": "eslint --fix -c eslint.config.yaml.mjs . ",
    "create-release": "bash scripts/create_release.sh $1",
    "test": "jest --silent --config test/jest.config.ts",
    "integ": "jest -i --config integration-tests/jest.config.ts",
    "metrics-validations": "jest -i --config metrics-validations/jest.config.ts",
    "integ-test-setup": "if [ -n \"$CI_PROJECT_DIR\" ]; then node ${SCRIPTS_PATH}/test_setup.js; else node scripts/test_setup.js; fi",
    "integ-test-teardown": "if [ -n \"$CI_PROJECT_DIR\" ]; then node ${SCRIPTS_PATH}/test_teardown.js; else node scripts/test_teardown.js; fi"
  }
}
